{
  "name": "@enterprise-rag-kb/shared",
  "version": "1.0.0",
  "description": "Shared enums and types for langchain-rag",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./enums": {
      "import": {
        "types": "./dist/enums/index.d.ts",
        "default": "./dist/enums/index.js"
      },
      "require": {
        "types": "./dist/enums/index.d.cts",
        "default": "./dist/enums/index.cjs"
      }
    },
    "./interfaces": {
      "import": {
        "types": "./dist/interfaces/index.d.ts",
        "default": "./dist/interfaces/index.js"
      },
      "require": {
        "types": "./dist/interfaces/index.d.cts",
        "default": "./dist/interfaces/index.cjs"
      }
    },
    "./constants": {
      "import": {
        "types": "./dist/constants/index.d.ts",
        "default": "./dist/constants/index.js"
      },
      "require": {
        "types": "./dist/constants/index.d.cts",
        "default": "./dist/constants/index.cjs"
      }
    },
    "./events": {
      "import": {
        "types": "./dist/events/index.d.ts",
        "default": "./dist/events/index.js"
      },
      "require": {
        "types": "./dist/events/index.d.cts",
        "default": "./dist/events/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "tsup": "catalog:"
  }
}
