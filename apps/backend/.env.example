# ===== 数据库 =====
# PostgreSQL（pgvector 镜像，见 docker/docker-compose.yml）
DATABASE_URL=postgresql://root:chenjiang@localhost:5432/langchain_rag

# ===== Elasticsearch（词法检索路） =====
# BM25 关键词检索由 PG 手写 SQL 迁至 ES（见 docker/docker-compose.yml）
# 本地开发默认 http://localhost:9200；Docker 部署时为 http://elasticsearch:9200
ES_URL=http://localhost:9200

# ===== LLM 对话模型 =====
# 两种 provider：
#   LLM_PROVIDER=ollama → 本地 Ollama（http://localhost:11434）
#   LLM_PROVIDER=ark/其他 → OpenAI 兼容接口（火山方舟 / DeepSeek 等）
LLM_PROVIDER=ark
# OpenAI 兼容接口地址（火山方舟）
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 对应 OPENAI 兼容协议的 API Key（火山方舟 ARK_API_KEY）
OPENAI_API_KEY=your-ark-api-key
# 模型名（ark 模式下用；ollama 模式下忽略，用 OLLAMA_MODEL）
LLM_MODEL=doubao-seed-2-0-mini-260428
# 本地 Ollama 配置（仅 LLM_PROVIDER=ollama 时生效）
# OLLAMA_MODEL=qwen3.5:0.8b

# ===== Embedding 向量化 =====
# EMBEDDING_PROVIDER=ark → 豆包火山方舟；=ollama → 本地 qwen3-embedding
EMBEDDING_PROVIDER=ark
EMBEDDING_API_KEY=your-ark-api-key
# 豆包多模态 embedding（1024 维，与 pgvector 表一致）
EMBEDDING_MODEL=doubao-embedding-vision-251215
EMBEDDING_DIMENSIONS=1024

# ===== Unstructured Transform 云 API =====
# transform.unstructured.io 控制台「API Keys」获取；PDF 版面分析（hi_res/chi_sim）
UNSTRUCTURED_API_KEY=your-unstructured-api-key

# ===== 百度 OCR（扫描页兜底） =====
BAIDU_OCR_API_KEY=your-baidu-ocr-key
BAIDU_OCR_SECRET_KEY=your-baidu-ocr-secret

# ===== 图片语义化（PDF 内嵌流程图/架构图 → VLM 描述） =====
# provider=none 关闭；=ark 时下面三个配好即启用
IMAGE_VLM_PROVIDER=ark
IMAGE_VLM_API_KEY=your-ark-api-key
# 留空走默认 ark endpoint
IMAGE_VLM_API_URL=
IMAGE_VLM_MODEL=doubao-seed-2-0-mini-260428
# IMAGE_VLM_MAX_IMAGES=20
# IMAGE_VLM_CONCURRENCY=3
# IMAGE_VLM_TIMEOUT_MS=30000
