{
  "name": "langchain-rag",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "dev:frontend": "pnpm --filter @langchain-rag/frontend dev",
    "dev:backend": "pnpm --filter @langchain-rag/backend start:dev",
    "build:shared": "pnpm --filter @langchain-rag/shared build",
    "dev:shared": "pnpm --filter @langchain-rag/shared dev",
    "build:ai-engine": "pnpm --filter @langchain-rag/ai-engine build",
    "dev:ai-engine": "pnpm --filter @langchain-rag/ai-engine dev",
    "db:migrate": "pnpm --filter @langchain-rag/backend db:migrate",
    "db:reset": "pnpm --filter @langchain-rag/backend db:reset",
    "db:generate": "pnpm --filter @langchain-rag/backend db:generate",
    "db:seed": "pnpm --filter @langchain-rag/backend db:seed",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "koffi",
      "sharp",
      "protobufjs",
      "unrs-resolver"
    ]
  }
}
