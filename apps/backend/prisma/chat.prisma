// ============================================================================
// 1. chat_conversation — 会话（元数据 + 分支指针）
// ============================================================================
// 业务元数据（标题/用户/知识库/统计）在此；pi 会话本体由 pi 原生 JSONL 文件
// 持久化（ai-engine 管理，路径 .pi-sessions/conv-<id>.jsonl），本表仅保留
// leaf_entry_id 指针：pi 从文件恢复时 leaf 总是文件最后一条 entry，切分支后
// 必须单独存目标 entry id，下次对话 ai-engine 据此 branch 定位。
// 消息列表、分支、编辑、切分支由 PiSessionService 操作 JSONL 派生。

model ChatConversation {
  id     BigInt @id @default(autoincrement())
  userId Int    @map("user_id")

  title        String? @db.VarChar(255)
  systemPrompt String? @map("system_prompt") @db.Text

  // pi 会话本体存 JSONL 文件（ai-engine 管理）；PG 记录文件位置 + 分支指针
  sessionFile String? @map("session_file") @db.VarChar(255)
  // 当前分支尾 entry id（跨请求切分支用）
  leafEntryId String? @map("leaf_entry_id") @db.VarChar(255)

  messageCount Int @default(0) @map("message_count")
  totalTokens  Int @default(0) @map("total_tokens")
  branchCount  Int @default(1) @map("branch_count")

  status Int @default(1) @db.SmallInt

  knowledgeId Int? @map("knowledge_id")

  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  user      User           @relation(fields: [userId], references: [id])
  knowledge KnowledgeBase? @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)

  @@index([userId, lastMessageAt(sort: Desc)])
  @@index([status])
  @@map("chat_conversation")
}
